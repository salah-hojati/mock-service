<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Mock Service</display-name>

    <!-- JSF Servlet -->
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <!-- ===== FIX: View State Configuration ===== -->
    <!-- Use server-side state saving (more reliable with WebLogic) -->
    <context-param>
        <param-name>javax.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value>
    </context-param>

    <!-- Disable view state compression to avoid issues -->
    <context-param>
        <param-name>javax.faces.COMPRESS_STATE</param-name>
        <param-value>false</param-value>
    </context-param>

    <!-- Set view state timeout (optional) -->
    <context-param>
        <param-name>com.sun.faces.numberOfViewsInSession</param-name>
        <param-value>5</param-value>
    </context-param>

    <!-- Increase view state size limit -->
    <context-param>
        <param-name>com.sun.faces.maxNumberOfViews</param-name>
        <param-value>5</param-value>
    </context-param>

    <!-- Disable partial state saving (fixes StringIndexOutOfBoundsException) -->
    <context-param>
        <param-name>javax.faces.PARTIAL_STATE_SAVING</param-name>
        <param-value>false</param-value>
    </context-param>

    <!-- Auth Filter - Using web.xml instead of @WebFilter -->
    <!-- Uncomment when ready -->
    <!--
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>org.example.mock.filter.AuthFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    -->

    <!-- Welcome page -->
    <welcome-file-list>
        <welcome-file>ui2/login.xhtml</welcome-file>
    </welcome-file-list>

    <!-- PrimeFaces Theme -->
    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>saga</param-value>
    </context-param>

    <!-- Facelets configuration -->
    <context-param>
        <param-name>javax.faces.FACELETS_SKIP_COMMENTS</param-name>
        <param-value>true</param-value>
    </context-param>

    <context-param>
        <param-name>javax.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>
</web-app>